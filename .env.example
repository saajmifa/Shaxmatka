# Copy this file's contents into Netlify: Site configuration -> Environment
# variables -> Add a variable -> Import from a .env file.
# Do NOT commit a real .env file with actual secrets to GitHub — these
# values belong only in Netlify's environment variables, never in the repo.

FOUNDER_USERNAME=admin
FOUNDER_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=replace_with_a_long_random_string_32_chars_or_more
